@{
    var data = ViewBag.Data;
}
<style>
    table.dataTable thead th {
        background: #dfe3e8;
        color: #2f4050;
        font-size: 13px;
        border-bottom: 1px solid #c5cbd3;
    }

    table.dataTable tbody td {
        font-size: 13px;
        vertical-align: middle;
    }

    .dataTables_wrapper .dt-buttons button {
        background: #e9ecef;
        border: 1px solid #c8ced3;
        padding: 5px 10px;
        margin-right: 5px;
        font-size: 13px;
    }

    .dataTables_filter input,
    .dataTables_length select {
        border: 1px solid #c8ced3;
        padding: 4px;
    }
</style>
<table id="designTable" class="table table-striped table-bordered w-100">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Project</th>
            <th>Order</th>
            <th>Area</th>
            <th>Email Dt</th>
            <th>Allocated</th>
            <th>Received</th>
            <th>Submitted</th>
            <th>Approved</th>
            <th>User</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in data)
        {
            <tr>
                <td>@item.CustomerNo</td>
                <td>@item.ProjectName</td>
                <td>@item.OrderNo</td>
                <td>@item.AreaName</td>
                <td>@item.CustEmailDt</td>
                <td>@item.Allocateddt</td>
                <td>@item.Receiveddt</td>
                <td>@item.CustSubmitdt</td>
                <td>@item.CustApproveddt</td>
                <td>@item.SharedUser</td>
            </tr>
        }
    </tbody>
</table>
<script>
    $(document).ready(function () {
        $('#designTable').DataTable({
            pageLength: 10,
            ordering: false,
            searching: true,
            fixedHeader: true,
            dom: 'lBfrtip',
            buttons: ['csv', 'excel', 'pdf', 'print']
        });
    });
</script>

