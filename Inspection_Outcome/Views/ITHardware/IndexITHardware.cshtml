@model IEnumerable<dynamic>

<form method="post">

    <div class="row mb-3">

        <div class="col-md-2">
            <select name="username" class="form-select">
                <option value="">Select User</option>
                @foreach (var u in Model.Select(x => x.UserName).Distinct())
                {
                    <option value="@u">@u</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <select name="systemSrNo" class="form-select">
                <option value="">Select System</option>
                @foreach (var s in Model.Select(x => x.SystemSrNo).Distinct())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <button formaction="/ITHardware/IndexITHardware" class="btn btn-primary">
                Search
            </button>
        </div>
        <div class="col-md-6"> 
        <button formaction="/ITHardware/PrintSelected"
                class="btn btn-info"
                onclick="return validateSelection()">
            Print Selected
        </button>

        <button formaction="/ITHardware/ExportExcel"
                class="btn btn-success"
                onclick="return validateSelection()">
            Download Excel
        </button>

        <button formaction="/ITHardware/ExportPDF"
                class="btn btn-danger"
                onclick="return validateSelection()">
            Download PDF
        </button>
        </div>

    </div>
    
    <partial name="_HardwareTable" model="Model" />

  

</form>
<script>
    function validateSelection() {

        let selected = document.querySelectorAll(
            'input[name="selectedSystems"]:checked'
        );

        if (selected.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'No row selected',
                text: 'Please select at least one system.',
                confirmButtonColor: '#3085d6'
            });

            return false; // stop submit
        }

        return true; // allow submit
    }
</script>
