@{
    ViewData["Title"] = "Dispatch Entry";
}

<style>
    body {
        background: #f1f5f9;
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
    }

    .dispatch-header {
        background: linear-gradient(90deg, #1d5fd1, #0d6efd);
        padding: 14px 30px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        margin-bottom: 15px;
    }

    .dispatch-title {
        color: #fff;
        font-size: 20px;
        font-weight: 600;
        min-width: 200px;
    }

    .dispatch-filters {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 30px;
    }

        .dispatch-filters label {
            color: #fff;
            font-size: 13px;
            margin-right: 6px;
            margin-bottom: 0;
            font-weight: 500;
            white-space: nowrap;
        }

        .dispatch-filters .form-select,
        .dispatch-filters .form-control {
            height: 36px;
            min-width: 160px;
            border-radius: 6px;
            border: none;
            font-size: 13px;
            padding-left: 10px;
        }

    @@media (max-width: 992px) {
        .dispatch-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .dispatch-filters {
            position: static;
            transform: none;
            width: 100%;
            gap: 15px;
            margin-top: 10px;
        }
    }

    .nav-tabs {
        border-bottom: 2px solid #dee2e6;
        margin-bottom: 12px;
    }

        .nav-tabs .nav-link {
            font-weight: 500;
            font-size: 14px;
            color: #495057;
            border-radius: 6px 6px 0 0;
            padding: 8px 16px;
        }

            .nav-tabs .nav-link:hover {
                background: #f1f5fb;
            }

            .nav-tabs .nav-link.active {
                background: #0d6efd;
                color: #fff;
                border-color: #0d6efd;
            }

        .nav-tabs .badge {
            font-size: 11px;
            padding: 3px 7px;
            border-radius: 6px;
            margin-left: 6px;
        }

    .dispatch-table-wrapper {
        background: #f8fafc;
        border: 1px solid #d6dbe1;
        max-height: 65vh;
        overflow-y: auto;
        overflow-x: hidden;
        width: 100%;
    }

        .dispatch-table-wrapper table {
            width: 100%;
            table-layout: fixed;
        }

        .dispatch-table-wrapper thead th {
            background: #cfd6df;
            color: #1f2933;
            font-weight: 600;
            border: 1px solid #c5ccd6;
            position: sticky;
            top: 0;
            z-index: 5;
            white-space: normal;
            word-break: break-word;
            text-align: center;
            padding: 3px 4px !important;
            font-size: 11px !important;
            line-height: 1.2 !important;
        }

        .dispatch-table-wrapper td {
            background: #fff;
            border: 1px solid #e3e7ed;
            padding: 2px 4px !important;
            font-size: 12px;
            white-space: normal;
            word-break: break-word;
            text-align: center;
            line-height: 1.2 !important;
        }

    tbody tr:nth-child(even) td {
        background: #f6f8fb;
    }

    tbody tr:hover td {
        background: #e8f1ff;
    }

    tbody tr:has(.chkRow:checked) td {
        background: #dbeafe !important;
    }

    .dispatch-filters input,
    .dispatch-filters select {
        height: 35px;
        font-size: 13px;
    }

    #loadingOverlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(255,255,255,.6);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

        #loadingOverlay.show {
            display: flex;
        }
    /* Row height kam karo */
    #pendingTable tbody tr td {
        padding: 2px 4px !important;
    }

    .dispatch-table-wrapper .form-control,
    .dispatch-table-wrapper .form-select {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        padding: 2px 4px !important;
        height: 28px !important;
        font-size: 12px !important;
    }

        .dispatch-table-wrapper .form-control:focus,
        .dispatch-table-wrapper .form-select:focus {
            border: none !important;
            box-shadow: none !important;
            outline: none !important;
        }

    .dispatch-table-wrapper tbody tr td {
        padding: 2px 4px !important;
    }
</style>

<div id="loadingOverlay">
    <div class="spinner-border text-primary" style="width:3rem;height:3rem;"></div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer"></div>

<form id="__AjaxForm" style="display:none">@Html.AntiForgeryToken()</form>

<div class="container-fluid mt-3">

    <!-- HEADER -->
    <div class="dispatch-header">
        <div class="dispatch-title">🚚 Dispatch Entry</div>
        <div class="dispatch-filters">
            <div class="d-flex align-items-center">
                <label>Customer :</label>
                <select id="ddlCustomer" class="form-select">
                    <option value="">-- Select Customer --</option>
                    @foreach (var c in (List<string>)ViewBag.Customers)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="d-flex align-items-center">
                <label>Order :</label>
                <select id="ddlOrder" class="form-select" disabled>
                    <option value="">-- Select Project --</option>
                </select>
            </div>
            <div class="d-flex align-items-center">
                <label>Search :</label>
                <input type="text" id="tableSearch" class="form-control" placeholder="Search..." />
            </div>
        </div>
    </div>

    <!-- TABS -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#pendingTab">
                🕒 Pending <span class="badge bg-secondary" id="pendingCount">0</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#rejectedTab">
                ❌ Rejected <span class="badge bg-danger" id="rejectedCount">0</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#dispatchedTab">
                ✅ Dispatched <span class="badge bg-success" id="dispatchedCount">0</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="pendingTab">
            <div id="pendingContent">
                <div class="alert alert-info text-center">👆 Please select Customer & Project to view data</div>
            </div>
        </div>
        <div class="tab-pane fade" id="rejectedTab">
            <div id="rejectedContent">
                <div class="alert alert-info text-center">👆 Please select Customer & Project to view data</div>
            </div>
        </div>
        <div class="tab-pane fade" id="dispatchedTab">
            <div id="dispatchedContent">
                <div class="alert alert-info text-center">👆 Please select Customer & Project to view data</div>
            </div>
        </div>
    </div>

</div>

<script>
    function getToken() {
        return $('#__AjaxForm input[name="__RequestVerificationToken"]').val();
    }
    function showLoading(v) {
        v ? $('#loadingOverlay').addClass('show') : $('#loadingOverlay').removeClass('show');
    }
    function showToast(msg, type = 'success') {
        const id = 't' + Date.now();
        const bg = type === 'success' ? 'text-bg-success' : 'text-bg-danger';
        $('#toastContainer').append(`
            <div id="${id}" class="toast align-items-center ${bg} border-0 show">
                <div class="d-flex">
                    <div class="toast-body">${msg}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>`);
        setTimeout(() => $('#' + id).remove(), 3500);
    }
    function clearTabs() {
        const html = '<div class="alert alert-info text-center">👆 Please select Customer & Project to view data</div>';
        $('#pendingContent, #rejectedContent, #dispatchedContent').html(html);
        $('#pendingCount, #rejectedCount, #dispatchedCount').text('0');
    }

    // ===== CUSTOMER CHANGE =====
    $('#ddlCustomer').on('change', function () {
        const code = $(this).val();
        $('#ddlOrder').html('<option value="">-- Select Project --</option>').prop('disabled', true);
        clearTabs();
        if (!code) return;

        showLoading(true);
        $.get('/Dispatched/GetOrders', { customerCode: code }, function (orders) {
            $.each(orders, function (i, o) {
                $('#ddlOrder').append(`<option value="${o}">${o}</option>`);
            });
            $('#ddlOrder').prop('disabled', false);
            showLoading(false);
            loadData(code, '');
        }).fail(function () { showLoading(false); showToast('Failed to load orders.', 'error'); });
    });

    // ===== ORDER CHANGE =====
    $('#ddlOrder').on('change', function () {
        const code = $('#ddlCustomer').val();
        if (code) loadData(code, $(this).val());
    });

    // ===== SEARCH =====
    $('#tableSearch').on('input', function () {
        const val = $(this).val().toLowerCase();
        $('#pendingTable tbody tr').each(function () {
            $(this).toggle($(this).text().toLowerCase().includes(val));
        });
    });

    // ===== LOAD DATA (Partial Views) =====
    function loadData(customerCode, orderNo) {
        showLoading(true);

        const p1 = $.get('/Dispatched/GetPendingPartial',   { customerCode, orderNo });
        const p2 = $.get('/Dispatched/GetRejectedPartial',  { customerCode, orderNo });
        const p3 = $.get('/Dispatched/GetDispatchedPartial',{ customerCode, orderNo });

        $.when(p1, p2, p3).done(function (r1, r2, r3) {
            $('#pendingContent').html(r1[0]);
            $('#rejectedContent').html(r2[0]);
            $('#dispatchedContent').html(r3[0]);

            // Badge counts
            $('#pendingCount').text($('#pendingTable tbody tr').length);
            $('#rejectedCount').text($('#rejectedContent table tbody tr td:first-child').filter(function () {
                return $(this).text().trim() !== '';
            }).length);
            $('#dispatchedCount').text($('#dispatchedContent table tbody tr').filter(function () {
                return $(this).find('td').length > 1;
            }).length);

            showLoading(false);
        }).fail(function () { showLoading(false); showToast('Failed to load data.', 'error'); });
    }

    function reloadData() {
        loadData($('#ddlCustomer').val(), $('#ddlOrder').val());
    }
        function saveDispatched() {
        var checked = $('.chkRowDisp:checked');
        if (checked.length === 0) {
            Swal.fire('No Selection', 'Please select at least one row', 'warning');
            return;
        }

        var hasError = false;
        checked.each(function () {
            var ship = $(this).closest('tr').find('.shipDisp').val();
            var date = $(this).closest('tr').find('.dateDisp').val();
            if (!ship || (ship !== 'TBC' && !date)) {
                hasError = true;
                $(this).closest('tr').addClass('table-warning');
            } else {
                $(this).closest('tr').removeClass('table-warning');
            }
        });

        if (hasError) {
            Swal.fire('Missing Fields', 'Please fill Ship Mode & Date correctly', 'error');
            return;
        }

        Swal.fire({
            icon: 'question',
            title: 'Save Selected?',
            showCancelButton: true,
            confirmButtonText: 'Yes, Save'
        }).then(function (result) {
            if (!result.isConfirmed) return;

            var payload = [];
            checked.each(function () {
                var row = $(this).closest('tr');
                payload.push({
                    id:           parseInt(row.data('id')),
                    shipMode:     row.find('.shipDisp').val(),
                    dispatchDate: row.find('.dateDisp').val() || null
                });
            });

            showLoading(true);
            $.ajax({
                url: '/Dispatched/UpdateDispatched',
                type: 'POST',
                contentType: 'application/x-www-form-urlencoded',
                data: {
                    __RequestVerificationToken: getToken(),
                    jsonData: JSON.stringify(payload)
                },
                success: function (res) {
                    showLoading(false);
                    if (res.success) { showToast(res.message); reloadData(); }
                    else showToast(res.message, 'error');
                },
                error: function (xhr) {
                    showLoading(false);
                    showToast('Error: ' + xhr.status + ' - ' + xhr.responseText, 'error');
                }
            });
        });
    }
</script>