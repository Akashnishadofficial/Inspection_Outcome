@model List<TblCarpetDispatch>

@{
    ViewData["Title"] = "Dispatch Approval";
}

<div class="container-fluid mt-3">

    <!-- ================= HEADER ================= -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h4 class="fw-bold text-primary mb-0">
                ✅ Dispatch Approval
                <small class="text-muted fs-6 ms-2">(Design Head)</small>
            </h4>
            <span class="badge bg-warning text-dark px-3 py-2">
                Pending: @(Model?.Count() ?? 0)
            </span>
        </div>
    </div>

    <!-- ================= TABLE ================= -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark text-center">
                    <tr>
                        <th>Customer</th>
                        <th>Project</th>
                        <th>Sr No</th>
                        <th>Design</th>
                        <th>Color</th>
                        <th>Quality</th>
                        <th style="width:90px">PCS</th>
                        <th style="width:130px">Ship Mode</th>
                        <th style="width:140px">Ship Date</th>
                        <th>W(ft)</th>
                        <th>W(in)</th>
                        <th>L(ft)</th>
                        <th>L(in)</th>
                        <th style="width:190px">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="13" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No record pending for approval
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var x in Model)
                        {
                            <tr>

                                <!-- BASIC INFO -->
                                <td class="fw-semibold">@x.CustomerCode</td>
                                <td>@x.ProjectName</td>
                                <td class="text-center">@x.SrNo</td>
                                <td>@x.DesignName</td>
                                <td>@x.ColorName</td>
                                <td>@x.Quality</td>
                                <!-- PCS (EDITABLE) -->
                                <td>
                                    <input type="number"
                                           min="1"
                                           class="form-control form-control-sm text-center fw-semibold border-primary"
                                           id="pcs_@x.Id"
                                           value="@x.Pcs" />
                                </td>

                                <!-- SHIP MODE -->
                                <td>
                                    <select class="form-select form-select-sm border-primary"
                                            id="ship_@x.Id">
                                        <option value="">-- Select --</option>
                                        <option value="Road" selected="@(x.ShipMode == "Road")">Road</option>
                                        <option value="Air" selected="@(x.ShipMode == "Air")">Air</option>
                                        <option value="Ship" selected="@(x.ShipMode == "Ship")">Ship</option>
                                    </select>
                                </td>

                                <!-- SHIP DATE -->
                                <td>
                                    <input type="date"
                                           class="form-control form-control-sm border-primary"
                                           id="dt_@x.Id"
                                           value="@x.DispatchDate?.ToString("yyyy-MM-dd")" />
                                </td>

                                <!-- DIMENSIONS -->
                                <td class="text-center text-muted">@x.WdthFt</td>
                                <td class="text-center text-muted">@x.WdthInch</td>
                                <td class="text-center text-muted">@x.LnthFt</td>
                                <td class="text-center text-muted">@x.LnthInch</td>

                                <!-- ACTIONS -->
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">

                                        <button type="button"
                                                class="btn btn-success btn-sm px-3"
                                                style="min-width:90px"
                                                onclick="approve(@x.Id)">
                                            Approve
                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm px-3"
                                                style="min-width:90px"
                                                onclick="reject(@x.Id)">
                                            Reject
                                        </button>

                                    </div>
                                </td>


                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>

<!-- ================= SCRIPT ================= -->
<script>

    function approve(id) {

        let pcs  = $('#pcs_' + id).val();
        let ship = $('#ship_' + id).val();
        let date = $('#dt_' + id).val();

        // Validation
        if (!pcs || pcs <= 0) {
            alert("PCS must be greater than 0");
            return;
        }
        if (!ship) {
            alert("Please select Ship Mode");
            return;
        }
        if (!date) {
            alert("Please select Ship Date");
            return;
        }

        if (!confirm("Approve this dispatch request?")) return;

        $.post('/Dispatch/Approve', {
            id: id,
            pcs: pcs,
            shipMode: ship,
            date: date
        }, function () {
            location.reload();
        });
    }

    function reject(id) {

        let remark = prompt("Enter reject reason:");
        if (!remark || remark.trim() === "") {
            alert("Reject reason is required");
            return;
        }

        $.post('/Dispatch/Reject', {
            id: id,
            remark: remark
        }, function () {
            location.reload();
        });
    }

</script>
